import React, { useState } from 'react';
import { Home, Target, Image, DollarSign, BarChart2, Menu, X, Upload, Plus, Edit, Trash2, Save, Send } from 'lucide-react';

// Main App Component
const App = () => {
  const [activeSection, setActiveSection] = useState('dashboard');
  const [isSidebarOpen, setIsSidebarOpen] = useState(false);

  const renderSection = () => {
    switch (activeSection) {
      case 'dashboard':
        return <Dashboard />;
      case 'media-optimization':
        return <MediaOptimization />;
      case 'creatives':
        return <Creatives />;
      case 'budgeting':
        return <Budgeting />;
      case 'analytics':
        return <Analytics />;
      default:
        return <Dashboard />;
    }
  };

  return (
    <div className="min-h-screen flex flex-col bg-gray-100 font-sans text-gray-800">
      {/* Header */}
      <header className="bg-white shadow-sm p-4 flex items-center justify-between md:justify-start sticky top-0 z-10">
        <button
          className="md:hidden p-2 rounded-md text-gray-700 hover:bg-gray-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          onClick={() => setIsSidebarOpen(!isSidebarOpen)}
        >
          {isSidebarOpen ? <X size={24} /> : <Menu size={24} />}
        </button>
        <h1 className="text-xl md:text-2xl font-bold text-indigo-700 ml-4">
          Optimizador de Medios Digitales
        </h1>
      </header>

      {/* Main Content Area */}
      <div className="flex flex-1 overflow-hidden">
        {/* Sidebar Navigation */}
        <aside
          className={`fixed inset-y-0 left-0 bg-indigo-800 text-white w-64 p-4 z-20 transform ${
            isSidebarOpen ? 'translate-x-0' : '-translate-x-full'
          } md:relative md:translate-x-0 transition-transform duration-300 ease-in-out flex-shrink-0 md:flex md:flex-col`}
        >
          <nav className="flex flex-col space-y-2 mt-4">
            <NavItem
              icon={<Home size={20} />}
              label="Panel de Control"
              isActive={activeSection === 'dashboard'}
              onClick={() => {
                setActiveSection('dashboard');
                setIsSidebarOpen(false);
              }}
            />
            <NavItem
              icon={<Target size={20} />}
              label="Optimización de Medios"
              isActive={activeSection === 'media-optimization'}
              onClick={() => {
                setActiveSection('media-optimization');
                setIsSidebarOpen(false);
              }}
            />
            <NavItem
              icon={<Image size={20} />}
              label="Creatividades"
              isActive={activeSection === 'creatives'}
              onClick={() => {
                setActiveSection('creatives');
                setIsSidebarOpen(false);
              }}
            />
            <NavItem
              icon={<DollarSign size={20} />}
              label="Presupuestos"
              isActive={activeSection === 'budgeting'}
              onClick={() => {
                setActiveSection('budgeting');
                setIsSidebarOpen(false);
              }}
            />
            <NavItem
              icon={<BarChart2 size={20} />}
              label="Analítica Productiva"
              isActive={activeSection === 'analytics'}
              onClick={() => {
                setActiveSection('analytics');
                setIsSidebarOpen(false);
              }}
            />
          </nav>
        </aside>

        {/* Content Area */}
        <main className="flex-1 p-4 md:p-8 overflow-y-auto">
          {renderSection()}
        </main>
      </div>
    </div>
  );
};

// Nav Item Component
const NavItem = ({ icon, label, isActive, onClick }) => (
  <button
    className={`flex items-center space-x-3 p-3 rounded-lg text-left w-full transition-colors duration-200 ${
      isActive ? 'bg-indigo-700 text-white' : 'hover:bg-indigo-700 hover:text-white text-indigo-200'
    }`}
    onClick={onClick}
  >
    {icon}
    <span className="text-lg">{label}</span>
  </button>
);

// Card Component for consistent styling
const Card = ({ title, children }) => (
  <div className="bg-white rounded-xl shadow-lg p-6 mb-6">
    <h2 className="text-2xl font-semibold text-indigo-700 mb-4 border-b pb-2">{title}</h2>
    {children}
  </div>
);

